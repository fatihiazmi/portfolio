# Copy to .env on the target LXC. Never commit .env.
# Spec references: section 6 (contact), 9.2 (admin), 11 (security), 7a (observability).

# --- app LXC: FastAPI ---
DATABASE_PATH=/data/portfolio.db
CORS_ORIGIN=https://fatihiazmi.dev
# Public base URL of the R2 images bucket. Leave commented to use the default.
# An empty value overrides the default and breaks image URLs.
# IMAGES_BASE_URL=https://img.fatihiazmi.dev
# Contact form. Guide: docs/guide/t9-contact-keys.md
# IP_HASH_SALT or TURNSTILE_SECRET empty: POST /api/contact returns 503.
# Random string, 32+ chars: openssl rand -hex 32. Salts the stored IP hash of leads.
IP_HASH_SALT=
TURNSTILE_SECRET=

# Resend (lead notification email). Empty: leads are stored, no email.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
# Sender on the Resend-verified domain. Leave commented to use the default.
# LEAD_FROM_EMAIL=fatihiazmi.dev <leads@send.fatihiazmi.dev>

# Cloudflare Access (admin JWT check)
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Cloudflare R2 (images). Token scoped to the images bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_IMAGES_BUCKET=

# --- app LXC: Litestream. These go in infra/app/.env.litestream, NOT in .env ---
# Separate file, so the API container never holds the backup keys.
# Token: R2 "Object Read & Write", scoped to the backup bucket only.
# Guide: docs/guide/t6-r2-backup.md
# R2_ACCOUNT_ID=
# R2_BACKUP_BUCKET=
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=

# Cloudflare Pages deploy hook (admin publish)
PAGES_DEPLOY_HOOK_URL=

# Cloudflare Tunnel
CLOUDFLARED_TUNNEL_TOKEN=

# --- obs LXC: Prometheus, Grafana, exporters ---
# Proxmox API token with the PVEAuditor role only
PVE_USER=
PVE_TOKEN_NAME=
PVE_TOKEN_VALUE=

GRAFANA_ADMIN_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
