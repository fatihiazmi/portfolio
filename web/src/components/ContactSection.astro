---
/**
 * Home page contact section: direct channels on the left, the form on the right.
 * Phones stack them: channels first, so WhatsApp is one tap away.
 */
import { CONTACT_EMAIL, WHATSAPP_DISPLAY, WHATSAPP_URL } from "../lib/site";
import ContactForm from "./ContactForm.astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";
---

<section id="contact" aria-labelledby="contact-heading" class="py-12">
  <h2 id="contact-heading" class="font-mono text-sm tracking-[0.2em] text-muted uppercase">
    Contact
  </h2>

  <div class="mt-6 grid gap-10 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:gap-16">
    <div>
      <p class="text-2xl font-semibold text-balance sm:text-3xl">Tell me what you need built.</p>
      <p class="mt-3 text-muted">
        I reply within 2 working days. Prefer chat? Message me on WhatsApp.
      </p>

      <ul class="mt-6 grid gap-3 sm:max-w-sm" aria-label="Direct contact">
        <li>
          <a
            href={WHATSAPP_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="flex min-h-14 items-center gap-3 bg-whatsapp px-4 py-3 text-ink-950 transition-colors hover:bg-whatsapp-strong motion-reduce:transition-none"
          >
            <WhatsAppIcon class="size-7 shrink-0" />
            <span class="flex flex-col">
              <span class="font-mono text-sm font-medium">WhatsApp me</span>
              <span class="text-sm">{WHATSAPP_DISPLAY}</span>
            </span>
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </li>
        <li>
          <a
            href={`mailto:${CONTACT_EMAIL}`}
            class="flex min-h-14 items-center gap-3 border border-line px-4 py-3 transition-colors hover:border-line-strong motion-reduce:transition-none"
          >
            <svg
              class="size-6 shrink-0 text-cyan"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
              focusable="false"
            >
              <rect x="3" y="5" width="18" height="14" rx="1"></rect>
              <path d="m3 7 9 6 9-6"></path>
            </svg>
            <span class="flex min-w-0 flex-col">
              <span class="font-mono text-sm font-medium">Email</span>
              <span class="truncate text-sm text-muted">{CONTACT_EMAIL}</span>
            </span>
          </a>
        </li>
      </ul>
    </div>

    <div class="sm:border sm:border-line sm:bg-ink-800/60 sm:p-8">
      <h3 class="font-mono text-xs tracking-[0.2em] text-muted uppercase">Send a message</h3>
      <ContactForm />
    </div>
  </div>
</section>
