---
/**
 * "Road closed" page. Spec section 3. Cloudflare Pages serves `404.html` with status 404
 * for any path that has no file.
 */
import Base from "../layouts/Base.astro";
---

<Base title="Road closed" description="This page does not exist.">
  <section aria-labelledby="notfound-heading" class="mx-auto max-w-xl py-12 text-center">
    <svg
      viewBox="0 0 240 120"
      class="mx-auto w-60"
      role="presentation"
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <pattern id="stripes" width="24" height="24" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <rect width="12" height="24" class="fill-amber" />
          <rect x="12" width="12" height="24" class="fill-ink-950" />
        </pattern>
      </defs>
      <rect x="20" y="30" width="200" height="34" fill="url(#stripes)" class="stroke-amber" stroke-width="2" />
      <g class="stroke-line-strong" stroke-width="4">
        <line x1="50" y1="64" x2="50" y2="112" />
        <line x1="190" y1="64" x2="190" y2="112" />
      </g>
      <g class="stroke-line" stroke-width="2" stroke-dasharray="8 8">
        <line x1="0" y1="116" x2="240" y2="116" />
      </g>
    </svg>

    <p class="mt-8 font-mono text-sm tracking-[0.2em] text-amber uppercase">404 · Road closed</p>
    <h1 id="notfound-heading" class="mt-3 text-3xl font-semibold text-balance">
      This page is not on the map.
    </h1>
    <p class="mt-3 text-muted">The link is wrong, or the page has moved.</p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="inline-flex min-h-11 items-center bg-amber px-5 font-mono text-sm font-medium text-ink-950 transition-colors hover:bg-paper motion-reduce:transition-none"
      >
        Back to the home page
      </a>
      <a
        href="/#work"
        class="inline-flex min-h-11 items-center border border-line-strong px-5 font-mono text-sm font-medium transition-colors hover:border-paper motion-reduce:transition-none"
      >
        See the work
      </a>
    </div>
  </section>
</Base>
