---
// Home page in the spec 3.1 order.
import ContactSection from "../components/ContactSection.astro";
import Hero from "../components/Hero.astro";
import HowIWork from "../components/HowIWork.astro";
import Services from "../components/Services.astro";
import WorkList from "../components/WorkList.astro";
import Base from "../layouts/Base.astro";
import { getProjects } from "../lib/projects";

const { projects, edges, source } = await getProjects();
---

<Base>
  <Hero projects={projects} edges={edges} />
  <Services projects={projects} />
  <HowIWork projects={projects} />
  <WorkList projects={projects} />
  <ContactSection />

  <p class="sr-only" data-projects-source={source}></p>
</Base>
